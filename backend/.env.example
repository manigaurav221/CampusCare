# Database Configuration (supports local or cloud MySQL like Aiven/Railway/AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=campus_care

# Optional: Cloud Database URL (if provided, overrides individual DB_* settings above)
# DATABASE_URL=mysql://user:pass@host:port/campus_care

# Optional: Set to 'true' if using a cloud MySQL host that requires SSL
# DB_SSL=true

# JWT Secret Key (Generate a random 64-char string for production)
JWT_SECRET=your_super_secret_jwt_key_generate_one_for_production

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Google Gemini API Key (Get a free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 (From Google Cloud Console -> Credentials -> Web Client)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Verification (SMTP configuration for sending verification OTPs)
# For Gmail, generate an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="CampusCare Verification" <no-reply@campuscare.edu>

