# API Base URL
# In development: http://localhost:5000/api
# In production (same host/monolith): leave empty or use /api
# In production (separate frontend host like Vercel): https://your-backend-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Client ID (matching the backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

